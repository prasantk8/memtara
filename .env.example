# Memtara backend configuration.
#
# Copy to `.env` and fill in. Every value here has a working default in
# `backend/api/src/config.rs` EXCEPT MEMTARA_PRIVATE_KEY, which has a
# deliberately unusable one — see below.
#
# .env is gitignored. Nothing in this file is a real secret.

# ---------------------------------------------------------------------------
# Cryptographic identity — the issuer key behind /.well-known/jwks.json
# ---------------------------------------------------------------------------

# Base64-encoded Ed25519 private key: either a 32-byte seed (usual) or a
# 64-byte seed||public pair (the public half is recomputed from the seed and
# the supplied copy is ignored, so a mismatched pair cannot produce tokens that
# fail against our own JWKS).
#
# Generate one:
#   openssl genpkey -algorithm ed25519 -out issuer.pem
#   openssl pkey -in issuer.pem -outform DER \
#     | tail -c 32 | base64
#
# or:
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
#
# LEAVING THIS UNSET IS NOT A NO-OP. The server generates an ephemeral key at
# boot and logs a warning. Tokens then verify normally until the process
# restarts, at which point every previously-issued token becomes invalid and
# every relying party's cached JWKS becomes stale. That is fine for `cargo
# test` and a laptop; it is a production outage.
#
# Rotation: relying parties key their cache on the JWK thumbprint (`kid`), so
# a new key produces a new kid. Publish both keys in the JWK Set for at least
# one token lifetime (300s) before retiring the old one, or in-flight tokens
# will fail validation.
MEMTARA_PRIVATE_KEY=

# Public base URL of this deployment. Stamped into every token's `iss` claim
# and used to build the JWKS URL relying parties are told to fetch. A relying
# party that validates `iss` — and it should — will reject otherwise-good
# tokens if this does not match the URL clients actually reach.
MEMTARA_ISSUER_BASE_URL=http://localhost:8080

# Where relying parties fetch the public key. Derived from the URL above; set
# explicitly only when Memtara sits behind a proxy that rewrites paths.
MEMTARA_PUBLIC_JWKS_URL=http://localhost:8080/.well-known/jwks.json

# Proof-token lifetime, seconds. Default 300.
#
# Read the §6(f) caveat in docs/REGULATORY_MATRIX.md before raising this. An
# issued token CANNOT be revoked inside its lifetime — that is the cost of
# offline validation, and this value is the entire bound on the exposure.
# The revocable primitives are the disclosure request and the session token.
MEMTARA_PROOF_TOKEN_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

DATABASE_URL=postgres://memtara:memtara@localhost:5433/memtara
BIND_ADDR=0.0.0.0:8080

# ---------------------------------------------------------------------------
# Sessions and OTP
# ---------------------------------------------------------------------------

SESSION_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# WebAuthn (passkeys)
#
# WEBAUTHN_RP_ORIGIN must match the frontend's origin exactly — scheme, host
# and port. A mismatch fails the ceremony with an error that does not say so.
# ---------------------------------------------------------------------------

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5173
WEBAUTHN_RP_NAME=Memtara

# ---------------------------------------------------------------------------
# UAE Pass (national digital identity, OIDC)
#
# Consumed only by StubUaePassProvider until real sandbox credentials exist.
# The flow, callback handling and account linking are real; the IdP call is not.
# ---------------------------------------------------------------------------

UAE_PASS_CLIENT_ID=dev-stub-client-id
UAE_PASS_CLIENT_SECRET=dev-stub-client-secret
UAE_PASS_REDIRECT_URI=http://localhost:5173/auth/uae-pass/callback
UAE_PASS_AUTHORIZE_URL=https://stg-id.uaepass.ae/idshub/authorize

# ---------------------------------------------------------------------------
# Zero-knowledge toolchain
#
# The server generates any missing verification keys at boot and refuses to
# start if `bb` is absent or the circuits are not compiled — a half-working
# verifier is worse than a server that will not come up.
# ---------------------------------------------------------------------------

BB_BIN=bb
# CIRCUITS_TARGET_DIR=/abs/path/to/circuits/target
# VKEYS_DIR=/abs/path/to/backend/api/vkeys

# The verification key published alongside the source, which a regulator would
# use to re-verify a suitability proof without trusting this deployment.
# `GET /health` compares it against the key actually in use and reports the
# instance degraded if they differ. Both keys work perfectly well in isolation,
# so a divergence has no other symptom — and it would mean every proof accepted
# today is unverifiable tomorrow by the examiner holding the committed key.
#
# Set this to an absolute path when the repository is not deployed alongside
# the binary. Leaving it unset in that case is legitimate; health then reports
# `unknown` rather than degrading the instance, because a deployment that ships
# without the repository is a real and reasonable one.
# MEMTARA_PUBLISHED_WEALTH_VKEY=/abs/path/to/circuits/wealth_suitability/vkey/vk

# ---------------------------------------------------------------------------
# Rate limiting
#
# Bounds the only genuinely expensive operation this server performs: one
# `bb verify` subprocess per proof submission. Ten per user per minute is
# generous for the real journey (one assessment, one proof) and ruinous for
# anyone trying to make the server do arithmetic on their behalf.
#
# In-process, therefore per-replica: two instances behind a load balancer
# permit 2N, not N. A deployment needing a true global limit needs it at the
# edge, or the `RateLimiter` swapped for a Redis-backed one — the seam is
# `ops/rate_limit.rs` and nothing else changes.
# ---------------------------------------------------------------------------

# MEMTARA_PROOF_RATE_LIMIT=10
# MEMTARA_PROOF_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Relying-party side (AIHOOTS gateway) — for reference, not read by this server
#
# See integrations/aihoots/memtara_claims.py.
# ---------------------------------------------------------------------------

# AIHOOTS_AUDIT_LOG_PATH=/data/audit.jsonl
# AIHOOTS_UPSTREAM_BASE_URL=http://model:11434
